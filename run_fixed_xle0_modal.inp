! TET10 fixed-free modal analysis with every x<=0 node fixed (mm, N, s, MPa)
! MESHCASE: 1-6=legacy 3/4/8; 7/8=16_full, 9/10=16_half, 11/12=24_half (modal/uniform)
! MATCASE : 201=whitened nu=0.30, 202=whitened nu=0.39

FINISH
/CLEAR,NOSTART
/FILNAME,fixed_xle0_modal,1
MESHCASE=1
MATCASE=201

/NOPR
*IF,MESHCASE,EQ,1,THEN
  /INPUT,../modal_cantilever3_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,2,THEN
  /INPUT,../uniform_cantilever3_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,3,THEN
  /INPUT,../modal_cantilever4_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,4,THEN
  /INPUT,../uniform_cantilever4_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,5,THEN
  /INPUT,../modal-8_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,6,THEN
  /INPUT,../uniform-8_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,7,THEN
  /INPUT,../modal16_full_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,8,THEN
  /INPUT,../uniform16_full_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,9,THEN
  /INPUT,../modal16_half_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,10,THEN
  /INPUT,../uniform16_half_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,11,THEN
  /INPUT,../modal24_half_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,12,THEN
  /INPUT,../uniform24_half_ansys_tet10,cdb
*ELSE
  /GOPR
  /COM,ERROR: MESHCASE must be an integer from 1 to 12.
  /EXIT,NOSAVE
*ENDIF
/GOPR

/PREP7
/UNITS,MPA
ALLSEL,ALL

! Whitened linear isotropic references; physical frequencies are scaled afterward.
! Density unit is tonne/mm^3 in the MPA unit system.
MP,EX,201,1
MP,NUXY,201,0.300
MP,DENS,201,1

MP,EX,202,1
MP,NUXY,202,0.390
MP,DENS,202,1

*IF,MATCASE,LT,201,THEN
  /COM,ERROR: MATCASE must be 201 or 202.
  /EXIT,NOSAVE
*ENDIF
*IF,MATCASE,GT,202,THEN
  /COM,ERROR: MATCASE must be 201 or 202.
  /EXIT,NOSAVE
*ENDIF
EMODIF,ALL,MAT,MATCASE

! Fix every node at or below x=0.
ALLSEL,ALL
DDELE,ALL,ALL
SELTOL,1.0E-9
NSEL,S,LOC,X,-1.0E9,0
*GET,NFIX,NODE,0,COUNT
*IF,NFIX,LE,0,THEN
  /COM,ERROR: No nodes satisfy x<=0.
  /EXIT,NOSAVE
*ENDIF
CM,FIX_X_LT_0,NODE
D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
ALLSEL,ALL
FINISH

/SOLU
ANTYPE,MODAL
PSTRES,OFF
LUMPM,OFF
! Element-by-element PCG Lanczos avoids the sparse factorization's 38 GB peak.
MODOPT,LANPCG,6
PCGOPT,1,OFF,NO,OFF,OFF
MSAVE,ON
MXPAND,6,,,NO
OUTRES,ALL,NONE
OUTRES,NSOL,ALL
SOLVE

*DIM,FREQ,ARRAY,6
*DO,I,1,6
  *GET,FREQ(I),MODE,I,FREQ
*ENDDO
*CFOPEN,modal_frequencies,csv
*VWRITE,'mode,frequency_hz'
(A20)
*DO,I,1,6
  FREQ_ONE=FREQ(I)
  *VWRITE,I,FREQ_ONE
(F3.0,',',E20.12)
*ENDDO
*CFCLOS
PARSAV,ALL,modal_frequency_parameters,parm
FINISH

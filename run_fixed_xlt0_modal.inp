! TET10 fixed-free modal analysis with every x<0 node fixed (mm, N, s, MPa)
! MESHCASE: 1=modal_cantilever3, 2=uniform_cantilever3
! MATCASE : 101=Inconel 718, 102=Structural Steel, 103=Formlabs Nylon 12 (SLS)

FINISH
/CLEAR,NOSTART
/FILNAME,fixed_xlt0_modal,1
MESHCASE=1
MATCASE=101

/NOPR
*IF,MESHCASE,EQ,1,THEN
  /INPUT,../modal_cantilever3_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,2,THEN
  /INPUT,../uniform_cantilever3_ansys_tet10,cdb
*ELSE
  /GOPR
  /COM,ERROR: MESHCASE must be 1 or 2.
  /EXIT,NOSAVE
*ENDIF
/GOPR

/PREP7
/UNITS,MPA
ALLSEL,ALL

! Room-temperature linear isotropic properties.
! Density unit is tonne/mm^3 in the MPA unit system.
MP,EX,101,165000
MP,NUXY,101,0.300
MP,DENS,101,8.220E-9

MP,EX,102,200000
MP,NUXY,102,0.300
MP,DENS,102,7.850E-9

MP,EX,103,1850
MP,NUXY,103,0.390
MP,DENS,103,9.900E-10

*IF,MATCASE,LT,101,THEN
  /COM,ERROR: MATCASE must be 101, 102, or 103.
  /EXIT,NOSAVE
*ENDIF
*IF,MATCASE,GT,103,THEN
  /COM,ERROR: MATCASE must be 101, 102, or 103.
  /EXIT,NOSAVE
*ENDIF
EMODIF,ALL,MAT,MATCASE

! Fix every node strictly below x=0.
ALLSEL,ALL
DDELE,ALL,ALL
SELTOL,1.0E-9
NSEL,S,LOC,X,-1.0E9,-1.0E-9
*GET,NFIX,NODE,0,COUNT
*IF,NFIX,LE,0,THEN
  /COM,ERROR: No nodes satisfy x<0.
  /EXIT,NOSAVE
*ENDIF
CM,FIX_X_LT_0,NODE
D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
ALLSEL,ALL
FINISH

/SOLU
ANTYPE,MODAL
PSTRES,OFF
LUMPM,OFF
! Element-by-element PCG Lanczos avoids the sparse factorization's 38 GB peak.
MODOPT,LANPCG,6
PCGOPT,1,OFF,NO,OFF,OFF
MSAVE,ON
MXPAND,6,,,NO
OUTRES,ALL,NONE
OUTRES,NSOL,ALL
SOLVE

*DIM,FREQ,ARRAY,6
*DO,I,1,6
  *GET,FREQ(I),MODE,I,FREQ
*ENDDO
*CFOPEN,modal_frequencies,csv
*VWRITE,'mode,frequency_hz'
(A20)
*DO,I,1,6
  FREQ_ONE=FREQ(I)
  *VWRITE,I,FREQ_ONE
(F3.0,',',E20.12)
*ENDDO
*CFCLOS
PARSAV,ALL,modal_frequency_parameters,parm
FINISH

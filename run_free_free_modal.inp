! TET10 unconstrained free-free modal analysis (mm, N, s, MPa)
! MESHCASE: 1=modal3, 2=uniform3, 3=modal4, 4=uniform4, 5=modal8, 6=uniform8
! MATCASE : 201=whitened nu=0.30, 202=whitened nu=0.39
! Modes 1-6 are rigid-body modes; modes 7-12 are elastic f1-f6.

FINISH
/CLEAR,NOSTART
/FILNAME,free_free_modal,1
MESHCASE=1
MATCASE=201

/NOPR
*IF,MESHCASE,EQ,1,THEN
  /INPUT,../modal_cantilever3_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,2,THEN
  /INPUT,../uniform_cantilever3_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,3,THEN
  /INPUT,../modal_cantilever4_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,4,THEN
  /INPUT,../uniform_cantilever4_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,5,THEN
  /INPUT,../modal-8_ansys_tet10,cdb
*ELSEIF,MESHCASE,EQ,6,THEN
  /INPUT,../uniform-8_ansys_tet10,cdb
*ELSE
  /GOPR
  /COM,ERROR: MESHCASE must be an integer from 1 to 6.
  /EXIT,NOSAVE
*ENDIF
/GOPR

/PREP7
/UNITS,MPA
ALLSEL,ALL

! Whitened linear isotropic references; physical frequencies are scaled afterward.
! Density unit is tonne/mm^3 in the MPA unit system.
MP,EX,201,1
MP,NUXY,201,0.300
MP,DENS,201,1

MP,EX,202,1
MP,NUXY,202,0.390
MP,DENS,202,1

*IF,MATCASE,LT,201,THEN
  /COM,ERROR: MATCASE must be 201 or 202.
  /EXIT,NOSAVE
*ENDIF
*IF,MATCASE,GT,202,THEN
  /COM,ERROR: MATCASE must be 201 or 202.
  /EXIT,NOSAVE
*ENDIF
EMODIF,ALL,MAT,MATCASE

! True free-free model: no displacement constraints.
ALLSEL,ALL
DDELE,ALL,ALL
FINISH

/SOLU
ANTYPE,MODAL
PSTRES,OFF
LUMPM,OFF
! PCG Lanczos detects rigid-body modes and avoids the sparse factorization's 38 GB peak.
! Element-by-element SOLID187 assembly can save up to 70% memory.
MODOPT,LANPCG,12
PCGOPT,1,OFF,NO,OFF,OFF
MSAVE,ON
MXPAND,12,,,NO
OUTRES,ALL,NONE
OUTRES,NSOL,ALL
SOLVE

*DIM,FREQ,ARRAY,12
*DO,I,1,12
  *GET,FREQ(I),MODE,I,FREQ
*ENDDO
*CFOPEN,modal_frequencies,csv
*VWRITE,'mode,frequency_hz'
(A20)
*DO,I,1,12
  FREQ_ONE=FREQ(I)
  *VWRITE,I,FREQ_ONE
(F3.0,',',E20.12)
*ENDDO
*CFCLOS
PARSAV,ALL,modal_frequency_parameters,parm
FINISH
